PORT=4000
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/quicktutor_db"

# REQUIRED: Generate a strong random string (e.g. openssl rand -hex 64)
JWT_SECRET="replace_with_a_long_random_secret_string"

# REQUIRED: Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="sk_live_or_test_your_key_here"

# OPTIONAL: Arkesel SMS — get from https://arkesel.com (leave blank to skip SMS)
ARKESEL_API_KEY="your_arkesel_api_key"

# OPTIONAL: SMTP for transactional emails (verification, password reset)
# If not set, links are printed to the server console instead
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_gmail@gmail.com"
SMTP_PASS="your_gmail_app_password"
SMTP_FROM="\"QuickTutor Ghana\" <your_gmail@gmail.com>"

# OPTIONAL: Admin SMS phone number for payment alerts
ADMIN_PHONE="233200000000"
